# FCGBS environment variables (names only; never commit real values). Copy to .env.local for development.
DATABASE_URL=            # PostgreSQL (Neon / Vercel Postgres). Local: postgres://postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_POOL_MAX=5
AUTH_SECRET=             # 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ENCRYPTION_KEY=          # 32+ random chars, different from AUTH_SECRET
SETUP_TOKEN=             # one-time key to create the first Super Admin at /backend (16+ chars); remove after setup
SUPERADMIN_EMAIL=        # only this e-mail may claim the platform (default folahandaniel@gmail.com)
APP_URL=                 # public base URL (QR verification links, sitemap, e-mails)
CRON_SECRET=             # protects /api/v1/cron/maintenance
RESEND_API_KEY=          # optional: e-mail delivery. Without it e-mails are HELD in the outbox, never falsely "sent"
EMAIL_FROM=
ANTHROPIC_API_KEY=       # optional: enables the AI assistant (also needs the aiAssistant feature flag)
